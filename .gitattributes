# 统一换行符，避免 Windows / Linux 混用时产生整文件 diff
* text=auto eol=lf

# 明确的文本类型
*.md    text eol=lf
*.py    text eol=lf
*.tcl   text eol=lf
*.v     text eol=lf
*.sv    text eol=lf
*.vhd   text eol=lf
*.xdc   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.bit   binary
*.dcp   binary
*.pdf   binary
# Preserve immutable experiment evidence bytes across Windows/Linux checkouts.
/data/results/** -text whitespace=cr-at-eol
/data/results/**/*.rpt -diff
/data/results/**/*.log -diff
/docs/verification/wo-0011-failure-evidence.json -text
/docs/verification/wo-0011-missed-events.csv -text
/docs/verification/wo-0011-failure-evidence.json whitespace=cr-at-eol
/docs/verification/wo-0011-missed-events.csv whitespace=cr-at-eol
/data/results/wo0013-resetfix-20261014/export/wo0013_dma_recreate.tcl -diff
/data/results/wo0013-resetfix-20261014/reports/implemented_constraints.xdc -diff
/scripts/wo0014/** -text whitespace=cr-at-eol
