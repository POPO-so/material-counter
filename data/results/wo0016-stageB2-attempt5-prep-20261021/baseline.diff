+    records.append({"frame_id": frame_id, "mm2s": f"0x{mm2s:08x}",
+                    "s2mm": f"0x{s2mm:08x}"})
+    if mm2s != EXPECTED_FRAME_DMASR or s2mm != EXPECTED_FRAME_DMASR:
+        raise RuntimeError(
+            f"frame {frame_id} DMA status mismatch: "
+            f"MM2S=0x{mm2s:08x}, S2MM=0x{s2mm:08x}"
+        )
