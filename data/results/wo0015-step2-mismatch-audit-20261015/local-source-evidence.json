  "xsim-tb": {
    "path": "C:\\Users\\POP\\.codex\\worktrees\\wo0015-design-20261015\\material-counter\\fpga\\sim\\wo0015\\tb_axis_dma_s2mm_pipeline.sv",
    "sha256": "7be500bf29aea048295b23c1eb2838c23468f87ed17947a7b3f7e28588536e9e",
    "excerpts": [
      {
        "line": 1,
        "text": "`timescale 1ns/1ps"
      },
      {
        "line": 2,
        "text": ""
      },
      {
        "line": 3,
        "text": "// Full-chain offline self-check: RGB packet -> Gray/Binary8 -> S2MM packer."
      },
      {
        "line": 4,
        "text": "// Input beats are 40-bit hex records {3'b0, TLAST, TKEEP, TDATA}; golden.hex"
      },
      {
        "line": 5,
        "text": "// contains one Binary8 byte per line. No AXI DMA IP or board is modeled here."
      },
      {
        "line": 6,
        "text": "module tb_axis_dma_s2mm_pipeline #("
      },
      {
        "line": 7,
        "text": "    parameter integer WIDTH = 320,"
      },
      {
        "line": 8,
        "text": "    parameter integer HEIGHT = 240,"
      },
      {
        "line": 9,
        "text": "    parameter integer THRESHOLD = 128"
      },
      {
        "line": 10,
        "text": ");"
      },
      {
        "line": 11,
        "text": "    localparam integer PIXELS_PER_FRAME = WIDTH * HEIGHT;"
      },
      {
        "line": 12,
        "text": "    localparam integer BEATS_PER_FRAME = PIXELS_PER_FRAME / 4;"
      },
      {
        "line": 103,
        "text": "    axis_dma_s2mm_pipeline_bd #("
      },
      {
        "line": 104,
        "text": "        .WIDTH(WIDTH), .HEIGHT(HEIGHT), .THRESHOLD(THRESHOLD)"
      },
      {
        "line": 105,
        "text": "    ) dut ("
      },
      {
        "line": 106,
        "text": "        .aclk(aclk), .aresetn(aresetn),"
      },
      {
        "line": 107,
        "text": "        .s_axi_awaddr(s_axi_awaddr), .s_axi_awvalid(s_axi_awvalid),"
      },
      {
        "line": 108,
        "text": "        .s_axi_awready(s_axi_awready), .s_axi_wdata(s_axi_wdata),"
      },
      {
        "line": 109,
        "text": "        .s_axi_wstrb(s_axi_wstrb), .s_axi_wvalid(s_axi_wvalid),"
      },
      {
        "line": 110,
        "text": "        .s_axi_wready(s_axi_wready), .s_axi_bresp(s_axi_bresp),"
      },
      {
        "line": 111,
        "text": "        .s_axi_bvalid(s_axi_bvalid), .s_axi_bready(s_axi_bready),"
      },
      {
        "line": 112,
        "text": "        .s_axi_araddr(s_axi_araddr), .s_axi_arvalid(s_axi_arvalid),"
      },
      {
        "line": 113,
        "text": "        .s_axi_arready(s_axi_arready), .s_axi_rdata(s_axi_rdata),"
      },
      {
        "line": 114,
        "text": "        .s_axi_rresp(s_axi_rresp), .s_axi_rvalid(s_axi_rvalid),"
      },
      {
        "line": 115,
        "text": "        .s_axi_rready(s_axi_rready), .s_axis_tdata(s_axis_tdata),"
      },
      {
        "line": 116,
        "text": "        .s_axis_tkeep(s_axis_tkeep), .s_axis_tlast(s_axis_tlast),"
      },
      {
        "line": 117,
        "text": "        .s_axis_tvalid(s_axis_tvalid), .s_axis_tready(s_axis_tready),"
      },
      {
        "line": 118,
        "text": "        .m_axis_tdata(m_axis_tdata), .m_axis_tkeep(m_axis_tkeep),"
      },
      {
        "line": 119,
        "text": "        .m_axis_tlast(m_axis_tlast), .m_axis_tvalid(m_axis_tvalid),"
      },
      {
        "line": 120,
        "text": "        .m_axis_tready(m_axis_tready)"
      },
      {
        "line": 121,
        "text": "    );"
      },
      {
        "line": 215,
        "text": "    endtask"
      },
      {
        "line": 216,
        "text": ""
      },
      {
        "line": 217,
        "text": "    task automatic arm_frame;"
      },
      {
        "line": 218,
        "text": "        begin"
      },
      {
        "line": 219,
        "text": "            axi_write(32'h0000005c, 32'h00000001);"
      },
      {
        "line": 220,
        "text": "        end"
      },
      {
        "line": 221,
        "text": "    endtask"
      },
      {
        "line": 495,
        "text": "                $fatal(1, \"legacy signature 0x04=0x%08x\", read_value);"
      },
      {
        "line": 496,
        "text": "            axi_write(32'h00000000, 32'h00000001);"
      },
      {
        "line": 497,
        "text": "            axi_read(32'h00000000, read_value);"
      },
      {
        "line": 498,
        "text": "            if (read_value != 1)"
      },
      {
        "line": 499,
        "text": "                $fatal(1, \"legacy drain control 0x00=%0d expected=1\", read_value);"
      },
      {
        "line": 500,
        "text": "            axi_read(32'h00000060, read_value);"
      },
      {
        "line": 501,
        "text": "            if (read_value != 32'h574f3135)"
      },
      {
        "line": 502,
        "text": "                $fatal(1, \"WO-0015 signature 0x60=0x%08x\", read_value);"
      },
      {
        "line": 503,
        "text": ""
      },
      {
        "line": 504,
        "text": "            if (mode == MODE_NORMAL || mode == MODE_RANDOM) begin"
      },
      {
        "line": 505,
        "text": "                expected_eof_count = frame_count;"
      },
      {
        "line": 506,
        "text": "                $display(\"STAGE normal start case=%0s frames=%0d seed=%0d beats=%0d\","
      },
      {
        "line": 507,
        "text": "                         case_label, frame_count, seed, input_count);"
      },
      {
        "line": 508,
        "text": "                arm_frame();"
      },
      {
        "line": 509,
        "text": "                fork"
      }
    ]
  }
