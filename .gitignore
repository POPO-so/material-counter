# ===== Vivado / Xilinx =====
*.jou
*.log
*.str
*.bit
*.ltx
*.dcp
*.runs/
*.cache/
*.hw/
*.sim/
*.ip_user_files/
.Xil/
*.xpr
*.pbx
*.xsa
*.hdf

# 不提交 Vivado 工程目录与生成的 IP
# ✅ 提交：rtl/ + xdc + scripts/build.tcl（任何人 clone 后跑一条 tcl 就能重建工程）

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.runtime/
*.egg-info/
.coverage
htmlcov/

# ===== 数据 =====
# 原始视频：外置存储 / 网盘；仓库只放短代表性片段（<20MB，走 Git LFS）
*.mp4
*.avi
*.mov
# 大体积合成的数据可重生成，不入库（保留生成脚本与 config.json）
data/synthetic/**/frames/
# Keep recorded captures local except the three reviewed WO-0017 handoff runs.
data/recorded/*
!data/recorded/wo0017-touching-20261024/
data/recorded/wo0017-touching-20261024/*
!data/recorded/wo0017-touching-20261024/wo_touching_pair_motion_20261024_03/
!data/recorded/wo0017-touching-20261024/wo_touching_three_motion_20261024_02/
!data/recorded/wo0017-touching-20261024/wo_touching_three_motion_20261024_04/

# ===== 实验产物例外 =====
# ★ 实验产物（CSV/JSON/图）必须入库，这是证据
!data/results/**
!data/synthetic/**/ground_truth.json
!data/synthetic/**/config.json
!data/labeled/**

# Reproducible tool workspaces and caches stay out of evidence snapshots.
# Reports, manifests and committed baseline vectors under data/results remain visible.
data/results/**/project/
data/results/**/rootfs/extracted/
data/results/**/xsim.dir/
data/results/**/__pycache__/
data/results/**/.pytest_cache/
data/results/**/*.py[cod]
data/results/**/*.jou
data/results/**/*.str
data/results/**/*.wdb
data/results/**/*.vcd
data/results/**/*.fst
data/results/**/*.fsdb
data/results/**/*.vpd
.vivado-ai/

